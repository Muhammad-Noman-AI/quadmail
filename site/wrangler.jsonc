{
  // Landing page for quadmail.quadgentics.com: static files only, no Worker code.
  // Deploy: pnpm site:deploy (from the repository root).
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "quadmail-site",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "quadmail.quadgentics.com", "custom_domain": true }]
}
