# Copy to .dev.vars for local development. Never commit .dev.vars.
# In production set these with `wrangler secret put <NAME>`.
RESEND_API_KEY=re_xxx
RESEND_WEBHOOK_SECRET=whsec_xxx
# 32 random bytes, base64. Generate: node -e "console.log(crypto.getRandomValues(Buffer.alloc(32)).toString('base64'))"
TOTP_ENC_KEY=
# Local dev only: match the port you run `pnpm dev` on (overrides wrangler.jsonc vars).
APP_URL=http://localhost:5173
