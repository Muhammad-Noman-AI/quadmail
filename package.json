{
  "name": "quadmail",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply quadmail --local",
    "db:migrate:remote": "wrangler d1 migrations apply quadmail --remote",
    "smoke:local": "bash scripts/smoke.sh --local",
    "smoke:remote": "bash scripts/smoke.sh --remote",
    "owner:password": "node scripts/set-owner-password.ts",
    "e2e": "node test/e2e/run.mjs",
    "backup:remote": "node scripts/backup.ts --remote",
    "backup:local": "node scripts/backup.ts --local",
    "icons": "node scripts/make-icons.ts",
    "seed:local": "node scripts/seed-local.ts"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "postal-mime": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  }
}
